# Telegram BotFather에서 발급받은 봇 토큰 (필수)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# https://www.api-football.com 무료 가입 후 대시보드에서 발급 (무료: 100 req/day)
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# https://platform.openai.com 에서 발급 (코멘트/예측 기능에 사용)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# API-Football 기준 월드컵 리그 ID(1)와 시즌(개최 연도)
WORLDCUP_LEAGUE_ID=1
WORLDCUP_SEASON=2026
